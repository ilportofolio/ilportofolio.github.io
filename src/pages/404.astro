---
import Layout from '../layouts/Layout.astro';
---

<!-- One 404 for both languages (static hosts serve a single 404.html). -->
<Layout title="404" alternates={{ en: '/', it: '/it/' }}>
	<section class="container nf">
		<h1 class="display">404.</h1>
		<p>This page doesn't exist.</p>
		<p lang="it">Questa pagina non esiste.</p>
		<div class="links">
			<a class="glass btn" href="/">Home</a>
			<a class="glass btn" href="/it/" lang="it">Home (IT)</a>
		</div>
	</section>
</Layout>

<style>
	.nf {
		display: grid;
		justify-items: start;
		gap: 12px;
		padding-top: 96px;
	}

	h1 {
		font-size: clamp(96px, 20vw, 200px);
	}

	p {
		margin: 0;
		color: var(--fg-muted);
	}

	.links {
		display: flex;
		gap: 8px;
		margin-top: 8px;
	}

	.btn {
		padding: 8px 18px;
		border-radius: 999px;
		text-decoration: none;
		font-size: 14px;
	}
</style>
