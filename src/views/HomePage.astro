---
import Layout from '../layouts/Layout.astro';
import PostGrid from '../components/PostGrid.astro';
import TagFilter from '../components/TagFilter.astro';
import { SITE } from '../data/site';
import { getLang, localizePath, useTranslations } from '../i18n/utils';
import { getPosts } from '../lib/posts';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const posts = await getPosts(lang);
const latest = posts.slice(0, 6);

// Longer copy lives here rather than in ui.ts because it carries markup.
const copy = {
	en: {
		intro: [
			"I'm <strong>Adonay Haile Ogbazghi</strong>, a cybersecurity graduate looking for my first role as a SOC Analyst (L1) or Cybersecurity Analyst, working on detection and incident response.",
			'I learn by building things and taking them apart: a <strong>home SOC lab</strong> where I simulate attack techniques and follow them from the endpoint to the alert, and <strong>static analysis</strong> of real malware.',
		],
		background: [
			'I studied cybersecurity at <strong>ITS Umbria Academy</strong> in Perugia, where I earned a Higher Technical Diploma (EQF level 5) between 2023 and 2025. The programme covered SIEM, incident response, digital forensics and malware analysis, with labs on ransomware and phishing scenarios and a network traffic module taught with the Italian Postal and Communications Police.',
			'During the course I spent six months as an intern at <strong>Lusios S.r.l.</strong>, a consulting firm in Perugia. I supported NIS2 audits and gap analysis: mapping the new requirements to existing controls with the NIST CSF as a reference, gathering evidence and helping to shape the remediation plan.',
			'Since then I have kept studying on my own. I completed the <strong>Hack The Box Academy SOC Analyst</strong> path and the Google Cybersecurity Professional Certificate, followed the OpenSecurityTraining2 courses on x86-64 and WinDbg, and finished all the challenges of <strong>Flare-On 13</strong>. The projects on this site are where I put that into practice.',
		],
	},
	it: {
		intro: [
			'Sono <strong>Adonay Haile Ogbazghi</strong>, diplomato in cybersecurity. Cerco il mio primo ruolo come SOC Analyst (L1) o Cybersecurity Analyst, in ambito detection e incident response.',
			'Imparo costruendo le cose e smontandole: un <strong>laboratorio SOC</strong> in cui simulo tecniche di attacco e le seguo dall\'endpoint fino all\'alert, e l\'<strong>analisi statica</strong> di malware reale.',
		],
		background: [
			'Ho studiato cybersecurity all\'<strong>ITS Umbria Academy</strong> di Perugia, dove ho conseguito il Diploma di Tecnico Superiore (livello EQF 5) tra il 2023 e il 2025. Il percorso comprendeva SIEM, incident response, digital forensics e analisi di malware, con laboratori su scenari di ransomware e phishing e un modulo sull\'analisi del traffico di rete tenuto con la Polizia Postale.',
			'Durante il corso ho svolto sei mesi di tirocinio presso <strong>Lusios S.r.l.</strong>, una società di consulenza di Perugia. Ho dato supporto ad audit e gap analysis NIS2: mappare i nuovi requisiti sui controlli esistenti con il NIST CSF come riferimento, raccogliere le evidenze e contribuire al piano di remediation.',
			'Da allora ho continuato a studiare per conto mio. Ho completato il percorso <strong>SOC Analyst di Hack The Box Academy</strong> e il Google Cybersecurity Professional Certificate, ho seguito i corsi di OpenSecurityTraining2 su x86-64 e WinDbg e ho portato a termine tutte le sfide di <strong>Flare-On 13</strong>. Nei progetti di questo sito metto in pratica tutto questo.',
		],
	},
}[lang];
---

<Layout>
	<section class="container hero" aria-label={t('home.label')}>
		<div class="guides" aria-hidden="true">
			<span style="top: 0%"><em>722</em></span>
			<span style="top: 34%"><em>532</em></span>
			<span style="top: 82%"><em>0</em></span>
			<span style="top: 100%"><em>-152</em></span>
		</div>
		<h1 class="display">
			<span>{t('home.role.top')}</span>
			<span>{t('home.role.bottom')}</span>
		</h1>
		<p class="name">{SITE.author}</p>
	</section>

	<section class="container intro">
		{copy.intro.map((para) => <p class="mono" set:html={para} />)}
		<p class="lead">{t('home.lead')}</p>
	</section>

	<section class="container block about">
		<div class="story" aria-labelledby="background">
			<h2 class="eyebrow" id="background">{t('home.background')}</h2>
			{copy.background.map((para) => <p set:html={para} />)}
			<a class="more" href={localizePath(lang, '/projects/')}>{t('home.projects')}</a>
		</div>
		<aside class="glass contact" id="contact" aria-labelledby="contact-title">
			<h2 class="eyebrow" id="contact-title">{t('home.contact')}</h2>
			<dl>
				<dt>{t('home.email')}</dt>
				<dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
				<dt>LinkedIn</dt>
				<dd><a href={SITE.linkedin} rel="me noopener noreferrer" target="_blank">{SITE.linkedinLabel}</a></dd>
				<dt>{t('home.availability')}</dt>
				<dd>{t('home.availability.local')}</dd>
				<dd>{t('home.availability.remote')}</dd>
			</dl>
		</aside>
	</section>

	<section class="container block" aria-labelledby="browse">
		<div class="row">
			<h2 class="eyebrow" id="browse">{t('home.browse')}</h2>
		</div>
		<TagFilter posts={posts} />
	</section>

	<section class="container block" aria-labelledby="latest">
		<div class="row">
			<h2 class="eyebrow" id="latest">{t('home.latest')}</h2>
			<a class="more" href={localizePath(lang, '/posts/')}>{t('home.allPosts')}</a>
		</div>
		<PostGrid posts={latest} level={3} />
	</section>
</Layout>

<style>
	.hero {
		position: relative;
		margin-top: 48px;
		margin-bottom: 72px;
	}

	.guides span {
		position: absolute;
		left: 0;
		right: 0;
		border-top: 1px solid var(--line-faint);
	}

	.guides em {
		position: absolute;
		right: var(--gutter);
		transform: translateY(-50%);
		padding: 1px 6px;
		border-radius: 3px;
		background: var(--fg);
		color: var(--pill-fg);
		font: 500 10px var(--font-mono);
		font-style: normal;
	}

	h1 {
		position: relative;
		font-size: clamp(48px, 13vw, 150px);
		line-height: 1;
	}

	h1 span {
		display: block;
	}

	.name {
		position: relative;
		margin: 24px 0 0;
		font-family: var(--font-mono);
		font-size: 14px;
		color: var(--fg-muted);
	}

	.about {
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		gap: 48px;
		align-items: start;
	}

	.story {
		display: grid;
		gap: 16px;
	}

	.story p {
		margin: 0;
		line-height: 1.7;
		color: var(--fg-muted);
	}

	.story :global(strong) {
		color: var(--fg);
		font-weight: 500;
	}

	.story .more {
		justify-self: start;
		color: var(--fg);
	}

	.contact {
		padding: 24px;
		scroll-margin-top: 24px;
	}

	.contact dl {
		margin: 16px 0 0;
	}

	.contact dt {
		margin-top: 16px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--fg-subtle);
	}

	.contact dd {
		margin: 4px 0 0;
		overflow-wrap: anywhere;
	}

	.contact a {
		color: var(--fg);
	}

	.intro {
		display: grid;
		grid-template-columns: 1fr 1fr 1.4fr;
		gap: 48px;
		padding-top: 40px;
		border-top: 1px solid var(--line);
	}

	.mono {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 14px;
		line-height: 1.6;
		color: var(--fg-muted);
	}

	.mono :global(strong) {
		color: var(--fg);
		font-weight: 400;
	}

	.lead {
		margin: 0;
		font-family: var(--font-pixel);
		font-size: clamp(26px, 3vw, 36px);
		line-height: 1.25;
	}

	.block {
		margin-top: 72px;
	}

	.row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 16px;
	}

	.more {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--fg-muted);
		text-decoration: none;
	}

	.more:hover {
		color: var(--fg);
	}

	@media (max-width: 760px) {
		.guides em {
			display: none;
		}

		.hero {
			margin-bottom: 40px;
		}

		.intro {
			grid-template-columns: 1fr;
			gap: 20px;
		}

		.about {
			grid-template-columns: 1fr;
			gap: 32px;
		}

		.block {
			margin-top: 48px;
		}
	}
</style>
