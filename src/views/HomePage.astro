---
import Layout from '../layouts/Layout.astro';
import PostGrid from '../components/PostGrid.astro';
import TagFilter from '../components/TagFilter.astro';
import { SITE } from '../data/site';
import { getLang, localizePath, useTranslations } from '../i18n/utils';
import { getPosts } from '../lib/posts';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const posts = await getPosts(lang);
const latest = posts.slice(0, 6);
---

<Layout>
	<section class="container hero" aria-label={t('home.label')}>
		<div class="guides" aria-hidden="true">
			<span style="top: 0%"><em>722</em></span>
			<span style="top: 34%"><em>532</em></span>
			<span style="top: 82%"><em>0</em></span>
			<span style="top: 100%"><em>-152</em></span>
		</div>
		<h1 class="display">{SITE.title}.</h1>
	</section>

	<section class="container intro">
		<p class="mono">
			Lorem ipsum dolor sit amet, <strong>consectetur</strong> adipiscing elit. Integer posuere erat a ante
			venenatis dapibus.
		</p>
		<p class="mono">
			Donec ullamcorper nulla non metus auctor fringilla. Vestibulum id ligula porta felis euismod <strong
				>semper</strong
			>.
		</p>
		<p class="lead">{t('site.description')}</p>
	</section>

	<section class="container block" aria-labelledby="browse">
		<div class="row">
			<h2 class="eyebrow" id="browse">{t('home.browse')}</h2>
		</div>
		<TagFilter posts={posts} />
	</section>

	<section class="container block" aria-labelledby="latest">
		<div class="row">
			<h2 class="eyebrow" id="latest">{t('home.latest')}</h2>
			<a class="more" href={localizePath(lang, '/posts/')}>{t('home.allPosts')}</a>
		</div>
		<PostGrid posts={latest} level={3} />
	</section>
</Layout>

<style>
	.hero {
		position: relative;
		margin-top: 48px;
		margin-bottom: 72px;
	}

	.guides span {
		position: absolute;
		left: 0;
		right: 0;
		border-top: 1px solid var(--line-faint);
	}

	.guides em {
		position: absolute;
		right: var(--gutter);
		transform: translateY(-50%);
		padding: 1px 6px;
		border-radius: 3px;
		background: var(--fg);
		color: var(--pill-fg);
		font: 500 10px var(--font-mono);
		font-style: normal;
	}

	h1 {
		position: relative;
		font-size: clamp(72px, 18vw, 220px);
		line-height: 1;
	}

	.intro {
		display: grid;
		grid-template-columns: 1fr 1fr 1.4fr;
		gap: 48px;
		padding-top: 40px;
		border-top: 1px solid var(--line);
	}

	.mono {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 14px;
		line-height: 1.6;
		color: var(--fg-muted);
	}

	.mono strong {
		color: var(--fg);
		font-weight: 400;
	}

	.lead {
		margin: 0;
		font-family: var(--font-pixel);
		font-size: clamp(26px, 3vw, 36px);
		line-height: 1.25;
	}

	.block {
		margin-top: 72px;
	}

	.row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 16px;
	}

	.more {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--fg-muted);
		text-decoration: none;
	}

	.more:hover {
		color: var(--fg);
	}

	@media (max-width: 760px) {
		.guides em {
			display: none;
		}

		.hero {
			margin-bottom: 40px;
		}

		.intro {
			grid-template-columns: 1fr;
			gap: 20px;
		}

		.block {
			margin-top: 48px;
		}
	}
</style>
