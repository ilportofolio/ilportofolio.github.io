---
import Layout from '../layouts/Layout.astro';
import { getLang, useTranslations } from '../i18n/utils';

const t = useTranslations(getLang(Astro.currentLocale));

const projects = [
	{ name: 'Lorem', year: '2026', blurb: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante.', stack: ['Astro', 'TypeScript'] },
	{ name: 'Ipsum', year: '2026', blurb: 'Donec ullamcorper nulla non metus auctor fringilla. Vestibulum id ligula porta.', stack: ['Go', 'SQLite'] },
	{ name: 'Dolor', year: '2025', blurb: 'Curabitur blandit tempus porttitor. Nullam quis risus eget urna mollis ornare.', stack: ['Python'] },
	{ name: 'Sit Amet', year: '2025', blurb: 'Maecenas faucibus mollis interdum. Cras mattis consectetur purus sit amet fermentum.', stack: ['Rust', 'WASM'] },
];
---

<Layout title={t('projects.title')}>
	<section class="container head">
		<p class="eyebrow">{t('projects.eyebrow')}</p>
		<h1 class="display">{t('projects.title')}.</h1>
		<p class="sub">{t('projects.sub')}</p>
	</section>

	<ul class="container grid">
		{
			projects.map((p) => (
				<li class="glass card">
					<div class="top">
						<h2>{p.name}</h2>
						<span class="year">{p.year}</span>
					</div>
					<p>{p.blurb}</p>
					<p class="stack">{p.stack.join(' · ')}</p>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.head {
		display: grid;
		gap: 12px;
		padding-top: 48px;
		padding-bottom: 40px;
	}

	h1 {
		font-size: clamp(56px, 10vw, 112px);
	}

	.sub {
		margin: 0;
		color: var(--fg-muted);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
		gap: 16px;
		margin: 0 auto;
		list-style: none;
	}

	.card {
		display: grid;
		gap: 10px;
		padding: 24px;
	}

	.top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
	}

	h2 {
		margin: 0;
		font-family: var(--font-pixel);
		font-weight: 500;
		font-size: 28px;
	}

	.year,
	.stack {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--fg-subtle);
	}

	p {
		margin: 0;
		color: var(--fg-muted);
	}
</style>
