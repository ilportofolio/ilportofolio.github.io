---
import { NAV, SITE } from '../data/site';
import { LANGS, type Lang } from '../i18n/ui';
import { getLang, localizePath, stripLang, useTranslations } from '../i18n/utils';

interface Props {
	/** Link to this page in each language. */
	alternates: Record<Lang, string>;
}

const { alternates } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const path = stripLang(Astro.url.pathname);
const isActive = (navPath: string) =>
	navPath === '/' ? path === '/' : path.startsWith(navPath) || (navPath === '/posts/' && path.startsWith('/tags/'));
---

<header class="container nav">
	<a class="logo" href={localizePath(lang, '/')} aria-label={`${SITE.title}: ${t('nav.home')}`}>▲</a>
	<nav class="tabs glass" aria-label={t('nav.label')}>
		{
			NAV.map((item) => (
				<a
					class:list={['tab', { active: isActive(item.path) }]}
					href={localizePath(lang, item.path)}
					aria-current={isActive(item.path) ? 'page' : undefined}
				>
					{t(item.key)}
				</a>
			))
		}
	</nav>
	<div class="end">
		<nav class="langs glass" aria-label={t('nav.language')}>
			{
				(Object.keys(LANGS) as Lang[]).map((l) => (
					<a
						class:list={['lang', { active: l === lang }]}
						href={alternates[l]}
						hreflang={l}
						lang={l}
						title={LANGS[l].label}
						aria-current={l === lang ? 'true' : undefined}
					>
						<span aria-hidden="true">{LANGS[l].short}</span>
						<span class="sr-only">{LANGS[l].label}</span>
					</a>
				))
			}
		</nav>
		<a class="cta" href={`mailto:${SITE.email}`}>{t('nav.contact')}</a>
	</div>
</header>

<style>
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding-top: 24px;
		padding-bottom: 24px;
	}

	.logo {
		font-size: 22px;
		line-height: 1;
		text-decoration: none;
	}

	.tabs,
	.langs {
		display: flex;
		gap: 2px;
		padding: 3px;
		border-radius: 999px;
	}

	.tab,
	.lang {
		padding: 5px 14px;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 500;
		text-decoration: none;
		transition: background-color 0.15s;
	}

	.lang {
		padding: 5px 9px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--fg-muted);
	}

	.tab:hover,
	.lang:hover {
		background: var(--glass-bg-hover);
		color: var(--fg);
	}

	.tab.active,
	.lang.active {
		background: var(--pill-bg);
		color: var(--pill-fg);
	}

	.tab.active {
		font-family: var(--font-pixel);
	}

	.end {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.cta {
		padding: 7px 16px;
		border-radius: 999px;
		background: var(--pill-bg);
		color: var(--pill-fg);
		font-size: 13px;
		font-weight: 500;
		text-decoration: none;
	}

	@media (max-width: 640px) {
		.nav {
			flex-wrap: wrap;
		}

		.tabs {
			order: 3;
			width: 100%;
			justify-content: space-between;
		}

		.tab {
			flex: 1;
			text-align: center;
		}
	}
</style>
