---
import { getLang, useTranslations } from '../i18n/utils';

const t = useTranslations(getLang(Astro.currentLocale));
---

<footer class="container footer">
	<p>© {new Date().getFullYear()} Adonay</p>
	<p>{t('footer.credits')}</p>
</footer>

<style>
	.footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 24px;
		padding-top: 24px;
		padding-bottom: 32px;
		border-top: 1px solid var(--line-faint);
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--fg-subtle);
	}

	p {
		margin: 0;
	}
</style>
